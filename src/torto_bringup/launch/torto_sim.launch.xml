<launch>
    
    <let name="urdf_path" 
        value="$(find-pkg-share torto_description)/urdf/torto.urdf" />

    <let name="rviz_config_path" 
        value="$(find-pkg-share torto_description)/rviz/urdf_config.rviz" />



    <node pkg="torto_input_handle" exec="ps5_ctrl_params_node" />
    
    <node pkg="torto_ctrl" exec="torto_controller_node" />   
    
    <node pkg="torto_hardware" exec="arduino_serial_node" />

    <node pkg="torto_hardware" exec="lidar_scan2cloud_node" />

    <node pkg="torto_odometry" exec="odom_depen_on_imu_node" />

    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description"
            value="$(command 'xacro $(var urdf_path)')" />
    </node>
    
    <node pkg="torto_sim_ctrl" exec="angles_to_joint_state" />
    
    <node pkg="rviz2" exec="rviz2" output="screen" args="-d $(var rviz_config_path)"/>

</launch>